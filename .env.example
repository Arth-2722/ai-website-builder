# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication (Self-hosted JWT - 100% Free)
JWT_SECRET=super_secret_jwt_key_change_in_production_12345

# Database (Optional: MongoDB Atlas Free M0 cluster or leave empty to use built-in local JSON storage)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/ai_website_builder?retryWrites=true&w=majority
MONGODB_URI=

# Free AI API Configuration (Choose at least one, or leave empty to use built-in offline smart generator!)
# Option 1: Google Gemini Free Tier API Key (Get free at https://aistudio.google.com/)
GEMINI_API_KEY=

# Option 2: OpenRouter Free Models API Key (Get free at https://openrouter.ai/)
OPENROUTER_API_KEY=

# Default AI Provider: "gemini" | "openrouter" | "template"
AI_PROVIDER=gemini
